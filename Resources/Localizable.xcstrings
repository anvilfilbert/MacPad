    "error.securityScopedAccessDenied" : {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"macOS hat MacPad keinen Zugriff auf diese Datei gewährt: %1$@. Wähle die Datei erneut aus, um den Zugriff wiederherzustellen."}},"en":{"stringUnit":{"state":"translated","value":"macOS did not grant MacPad access to this file: %1$@. Choose the file again to restore access."}}}},
    "error.persistentAccessUnavailableAfterWrite" : {"extractionState":"manual","localizations":{"de":{"stringUnit":{"state":"translated","value":"MacPad hat diese Datei gesichert, konnte den Zugriff darauf aber nicht beibehalten: %1$@. macOS meldete: %2$@. Wähle „Sichern unter“ und die Datei erneut aus, bevor du dieses Dokument schließt."}},"en":{"stringUnit":{"state":"translated","value":"MacPad saved this file, but could not retain access to it: %1$@. macOS reported: %2$@. Choose Save As and select the file again before closing this document."}}}},
